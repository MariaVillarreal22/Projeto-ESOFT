<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="pt.ipleiria.es.worldcup.ui.HotelsScreen">
  <grid id="root" binding="designerPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints><xy x="20" y="20" width="1180" height="720"/></constraints>
    <properties><background color="-15590179"/><preferredSize width="1180" height="720"/></properties>
    <border type="none"/>
    <children>
      <grid id="sidebar" layout-manager="GridLayoutManager" row-count="18" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="18" left="18" bottom="18" right="18"/>
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="190" height="720"/></grid></constraints>
        <properties><background color="-15589302"/><preferredSize width="190" height="720"/></properties>
        <border type="none"/>
        <children>
          <component id="brand" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><font name="Segoe UI" size="30" style="1"/><foreground color="-1"/><text value="FIFA°"/></properties></component>
          <component id="menuText" class="javax.swing.JLabel"><constraints><grid row="2" column="0" row-span="14" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><font name="Segoe UI" size="11" style="0"/><foreground color="-4593448"/><text value="&lt;html&gt;&lt;b&gt;COMPETIÇÕES&lt;/b&gt;&lt;br&gt;Fases&lt;br&gt;Calendário&lt;br&gt;Classificações&lt;br&gt;Estatísticas&lt;br&gt;&lt;br&gt;&lt;b&gt;ENTIDADES&lt;/b&gt;&lt;br&gt;Equipas&lt;br&gt;Árbitros&lt;br&gt;Estádios&lt;br&gt;&lt;br&gt;&lt;b&gt;BILHETES&lt;/b&gt;&lt;br&gt;Comprar&lt;br&gt;Bilhetes comprados&lt;br&gt;&lt;br&gt;&lt;b&gt;HOSPITALIDADE&lt;/b&gt;&lt;br&gt;&lt;b&gt;Hotéis&lt;/b&gt;&lt;br&gt;Locações&lt;/html&gt;"/></properties></component>
          <vspacer id="sideSpacer"><constraints><grid row="17" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/></constraints></vspacer>
        </children>
      </grid>
      <grid id="main" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties><background color="-15590179"/></properties>
        <border type="none"/>
        <children>
          <grid id="topbar" layout-manager="GridLayoutManager" row-count="1" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="-1">
            <margin top="9" left="12" bottom="9" right="14"/>
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"><preferred-size width="990" height="56"/></grid></constraints>
            <properties><background color="-14852645"/><preferredSize width="990" height="56"/></properties><border type="none"/>
            <children>
              <component id="hamb" class="javax.swing.JButton"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"><preferred-size width="42" height="34"/></grid></constraints><properties><background color="-14852645"/><borderPainted value="false"/><focusPainted value="false"/><font name="Segoe UI" size="22" style="1"/><foreground color="-1"/><text value=""/></properties></component>
              <component id="search" class="javax.swing.JTextField"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"><preferred-size width="360" height="34"/></grid></constraints><properties><text value="  Pesquisar hotel, cidade ou estádio..."/></properties></component>
              <component id="country" class="javax.swing.JComboBox"><constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"><preferred-size width="170" height="34"/></grid></constraints><properties><model><item value="Todos os países"/><item value="EUA"/><item value="Canadá"/><item value="México"/></model></properties></component>
              <component id="rating" class="javax.swing.JComboBox"><constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"><preferred-size width="150" height="34"/></grid></constraints><properties><model><item value="Classificação"/><item value="5 estrelas"/><item value="4 estrelas"/><item value="3 estrelas"/></model></properties></component>
              <component id="date" class="javax.swing.JTextField"><constraints><grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"><preferred-size width="130" height="34"/></grid></constraints><properties><font name="Segoe UI" size="10" style="1"/><text value="  JUNHO 2026"/></properties></component>
            </children>
          </grid>
          <grid id="content" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
            <margin top="12" left="18" bottom="18" right="18"/>
            <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
            <properties><background color="-15452049"/></properties><border type="none"/>
            <children>
              <component id="title" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><font name="Segoe UI" size="16" style="1"/><foreground color="-1"/><text value="HOTÉIS POPULARES"/></properties></component>
              <component id="addHotel" class="javax.swing.JButton"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"><preferred-size width="160" height="30"/></grid></constraints><properties><background color="6411156"/><font name="Segoe UI" size="10" style="1"/><foreground color="533308"/><text value="+ ADICIONAR HOTEL"/></properties></component>
              <scrollpane id="tableScroll"><constraints><grid row="1" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints><properties><background color="-15452049"/></properties><border type="line" color="-13805933"/><children><component id="hotelsTable" class="javax.swing.JTable"><constraints/><properties><background color="-15452049"/><foreground color="-1"/><gridColor color="-13805933"/><rowHeight value="86"/><showVerticalLines value="false"/></properties></component></children></scrollpane>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>

